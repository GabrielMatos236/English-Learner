# Copie para .env (local) e configure as mesmas variáveis na Vercel (Settings → Environment Variables).

# Senha da área do professor
ADMIN_PASSWORD=troque-essa-senha

# Segredo pra assinar o token de login (qualquer texto longo e aleatório)
AUTH_SECRET=gere-um-texto-aleatorio-bem-longo

# Preenchidas automaticamente pela integração Upstash Redis da Vercel.
# Localmente, se ficarem vazias, o app usa memória (os dados somem ao reiniciar).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Chave do Gemini (Google AI Studio → Get API key). Sem ela, o Practice usa exercícios de exemplo.
GEMINI_API_KEY=

# Opcional: modelo do Gemini (padrão: gemini-2.5-flash). Troque aqui se o Google aposentar o modelo.
GEMINI_MODEL=
