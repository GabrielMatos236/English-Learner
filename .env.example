# Copie para .env (local) e configure as mesmas variáveis na Vercel (Settings → Environment Variables).

# Senha da área do professor
ADMIN_PASSWORD=troque-essa-senha

# Segredo pra assinar o token de login (qualquer texto longo e aleatório)
AUTH_SECRET=gere-um-texto-aleatorio-bem-longo

# Preenchidas automaticamente pela integração Upstash Redis da Vercel.
# Localmente, se ficarem vazias, o app usa memória (os dados somem ao reiniciar).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# IAs do Practice. Ordem de tentativa (padrão: claude,gemini). Só entra quem tem chave.
# Sem nenhuma chave, o Practice usa exercícios de exemplo.
AI_PROVIDERS=

# Claude (platform.claude.com → API Keys). Modelo padrão: claude-haiku-5-5
ANTHROPIC_API_KEY=
CLAUDE_MODEL=

# Gemini (aistudio.google.com → Get API key). Modelo padrão: gemini-3.8-flash; reservas: gemini-3.6-flash
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FALLBACK_MODELS=
